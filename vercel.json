{
  "version": 2,
  "outputDirectory": "public",
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/media/(.*)", "dest": "/api/index.js" },
    { "src": "/mobile", "dest": "/mobile.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
