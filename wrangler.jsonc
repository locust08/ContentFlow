{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "contentflow-ai",
  "main": "cloudflare/worker/index.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/internal/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contentflow-ai-production",
      "database_id": "211f5157-dfd4-4cdc-a353-6f1e43714afe",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "contentflow-media-production"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "REQUIRE_AUTH": "true"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "contentflow-ai-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "contentflow-ai-preview",
          "database_id": "1b9f0094-f50d-4ff8-838d-62e72d9d03c2",
          "migrations_dir": "cloudflare/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "contentflow-media-preview"
        }
      ],
      "vars": {
        "APP_ENV": "preview",
        "REQUIRE_AUTH": "true"
      }
    }
  }
}
